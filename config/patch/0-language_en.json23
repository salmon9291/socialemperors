      {
        "id": "994",
        "name": "POPUP_MISION_ELFOSARBOL_TITULO",
        "text": "¡NATURALEZA EN PELIGRO!"
      },
      {
        "id": "995",
        "name": "POPUP_MISION_ELFOSARBOL_FOOTER",
        "text": "¡Ayuda a los Elfos a destruir las esculturas infernales que drenan la energía de los Árboles de la Vida!"
      },
      {
        "id": "996",
        "name": "POPUP_MISION_ELFOSARBOL_TITULO_END",
        "text": "¡NATURALEZA SALVADA!"
      },
      {
        "id": "997",
        "name": "POPUP_MISION_ELFOSARBOL_FOOTER_END",
        "text": "¡BIEN HECHO! Restauraste el equilibrio natural del bosque. ¡Dos elfos arqueros se unen a tus filas como prueba de gratitud!"
      },
      {
        "id": "998",
        "name": "POPUP_MISION_ELFOSARBOL_UNIT_SAY",
        "text": "ESTAMOS A SUS ORDENES, por el momento…"
      },
      {
        "id": "999",
        "name": "POPUP_MISION_CHINOSDRAGON_TITULO",
        "text": "¡Furia de Draggies!"
      },
      {
        "id": "1000",
        "name": "POPUP_MISION_CHINOSDRAGON_FOOTER",
        "text": "¡Tres Draggies están causando estragos en los campos y casas de tu imperio! ¡Derrótalos antes de que maten a alguien!"
      },
      {
        "id": "1001",
        "name": "POPUP_MISION_CHINOSDRAGON_TITULO_END",
        "text": "¡Draggies derrotados!"
      },
      {
        "id": "1002",
        "name": "POPUP_MISION_CHINOSDRAGON_FOOTER_END",
        "text": "¡BUEN TRABAJO! ¡Derrotaste a los draggies, pero el Dragón Furioso huyó a Nest Isle! ¡Dos agradecidos arqueros chinos se unen a tus filas!"
      },
      {
        "id": "1003",
        "name": "POPUP_MISION_CHINOSDRAGON_UNIT_SAY",
        "text": "¡AYUDA AL BUEN CHINO, Y EL CHINO TE RECOMPENSARÁ!"
      },
      {
        "id": "1004",
        "name": "POPUP_MISION_CHINOSDRAGON_BOSS_SAY",
        "text": "¡NO ME DERROTARÁN! Te estaré esperando en mi isla...\nSi te animas a venir ¡¡MUJAJAJAJA!!"
      },
      {
        "id": "1005",
        "name": "POPUP_MISION_NEPTUCLEOPATRA_TITULO",
        "text": "¡NEPTUNO ESTÁ ENAMORADO!"
      },
      {
        "id": "1006",
        "name": "POPUP_MISION_NEPTUCLEOPATRA_FOOTER",
        "text": "¡Neptuno rescató a Cleopatra de un naufragio y ahora se ha enamorado de ella! ¡Ayuda a los egipcios a rescatarla!"
      },
      {
        "id": "1007",
        "name": "POPUP_MISION_NEPTUCLEOPATRA_TITULO_END",
        "text": "¡Cleopatra rescatada!"
      },
      {
        "id": "1008",
        "name": "POPUP_MISION_NEPTUCLEOPATRA_FOOTER_END",
        "text": "¡BIEN HECHO! Neptuno ha huido a su morada en Isla Mítica... ¡Síguelo y derrota a su ejército para siempre!"
      },
      {
        "id": "1009",
        "name": "POPUP_MISION_NEPTUCLEOPATRA_UNIT_SAY",
        "text": "¡AYÚDANOS A SALVAR A NUESTRA REINA!"
      },
      {
        "id": "1010",
        "name": "POPUP_MISION_ELFOSENT_TITULO",
        "text": "¡EL MALVADO ENT!"
      },
      {
        "id": "1011",
        "name": "POPUP_MISION_ELFOSENT_FOOTER",
        "text": "¡El Ent ha sido hechizado por los seguidores del Infierno! ¡Ayuda a los elfos a liberarlo del hechizo!"
      },
      {
        "id": "1012",
        "name": "POPUP_MISION_ELFOSENT_TITULO_END",
        "text": "¡ENTRADA GRATIS!"
      },
      {
        "id": "1013",
        "name": "POPUP_MISION_ELFOSENT_FOOTER_END",
        "text": "¡Has destruido a los sirvientes del Infierno y el Ent ahora es libre! ¡Como muestra de gratitud, Elf Druid se une a tus filas!"
      },
      {
        "id": "1014",
        "name": "POPUP_MISION_ELFOSENT_UNIT_SAY",
        "text": "¡LIBEREMOS EL ENT DEL HECHIZO DEL DIABLO!"
      },
      {
        "id": "1015",
        "name": "POPUP_MISION_TESOROATLANTE_TITULO",
        "text": "¡EL TESORO DE LOS AZTECAS!"
      },
      {
        "id": "1016",
        "name": "POPUP_MISION_TESOROATLANTE_FOOTER",
        "text": "¡Ayuda a los aztecas a recuperar sus tesoros, robados por los atlantes del barco hundido de Hernán Cortés!"
      },
      {
        "id": "1017",
        "name": "POPUP_MISION_TESOROATLANTE_TITULO_END",
        "text": "¡TESOROS RECUPERADOS!"
      },
      {
        "id": "1018",
        "name": "POPUP_MISION_TESOROATLANTE_FOOTER_END",
        "text": "¡VIVA! ¡Ayudaste a los aztecas a recuperar sus tesoros y ellos te dieron una escultura de Jefe Azteca a cambio de tus esfuerzos!"
      },
      {
        "id": "1019",
        "name": "POPUP_MISION_TESOROATLANTE_UNIT_SAY",
        "text": "¡AYÚDANOS A RECUPERAR NUESTROS TESOROS!"
      },
      {
        "id": "1020",
        "name": "POPUP_MISION_BALROG_TITULO",
        "text": "¡EL TERRIBLE BALROG!"
      },
      {
        "id": "1021",
        "name": "POPUP_MISION_BALROG_FOOTER",
        "text": "¡Las fuerzas del Diablo han enviado al mismísimo Balrog para derrotar a tu imperio! ¡Los forasteros de Inferno se unirán a ti para derrotarlo a él y a su ejército!"
      },
      {
        "id": "1022",
        "name": "POPUP_MISION_BALROG_TITULO_END",
        "text": "¡BALROG HUYÓ!"
      },
      {
        "id": "1023",
        "name": "POPUP_MISION_BALROG_FOOTER_END",
        "text": "¡FELICIDADES! ¡Balrog huyó reclamando venganza! ¡Un extraño de Inferno se unirá a tus filas para ayudarte a detectar las fuerzas del mal!"
      },
      {
        "id": "1024",
        "name": "POPUP_MISION_BALROG_UNIT_SAY",
        "text": "¡TE AYUDAMOS A DERROTAR A BALROG!"
      },
      {
        "id": "1025",
        "name": "POPUP_MISION_MAGOSCORRUPTOS_TITULO",
        "text": "¡LOS MAGOS FALLOS!"
      },
      {
        "id": "1026",
        "name": "POPUP_MISION_MAGOSCORRUPTOS_FOOTER",
        "text": "Un grupo de magos asquerosos robó los Orbes de Poder. ¡Recupéralos antes de que causen estragos en tu imperio!"
      },
      {
        "id": "1027",
        "name": "POPUP_MISION_MAGOSCORRUPTOS_TITULO_END",
        "text": "¡MAGOS FALTOS DERROTADOS!"
      },
      {
        "id": "1028",
        "name": "POPUP_MISION_MAGOSCORRUPTOS_FOOTER_END",
        "text": "¡ERESS EL MEJOR! Recuperaste los Orbes de Poder y derrotaste al Mago Asqueroso. ¡El Mago Rojo podría salvarse de su locura y unirse a tus filas!"
      },
      {
        "id": "1029",
        "name": "POPUP_MISION_MAGOSCORRUPTOS_UNIT_SAY",
        "text": "¡MAGOSLOCOS DERROTADOS!"
      },
      {
        "id": "1030",
        "name": "POPUP_MISION_PERFORARROCAS_TITULO",
        "text": "¡AYUDA! ¡EL ROCKDRILLER ESTÁ AQUÍ!"
      },
      {
        "id": "1031",
        "name": "POPUP_MISION_PERFORARROCAS_FOOTER",
        "text": "¡Ayuda a los guerreros aztecas a derrotar al ROCKDRILLER! ¡Destruye las esculturas de la Serpiente para sacarla de su agujero!"
      },
      {
        "id": "1032",
        "name": "POPUP_MISION_PERFORARROCAS_TITULO_END",
        "text": "¡EL ROCKDRILLER HUYÓ!"
      },
      {
        "id": "1033",
        "name": "POPUP_MISION_PERFORARROCAS_FOOTER_END",
        "text": "¡LO HICISTE! ¡El Rockdriller huyó a Mineral Isle y ahora tu imperio está a salvo! ¡Los guerreros aztecas se unen a tus filas como muestra de su gratitud!"
      },
      {
        "id": "1034",
        "name": "POPUP_MISION_PERFORARROCAS_UNIT_SAY",
        "text": "¡VAMOS A DERROTARLO!"
      },
      {
        "id": "1035",
        "name": "POPUP_MISION_DEMONPORTAL_TITULO",
        "text": "¡LOS PORTALES DEMONÍACOS!"
      },
      {
        "id": "1036",
        "name": "POPUP_MISION_DEMONPORTAL_FOOTER",
        "text": "¡Algunos portales demoníacos han aparecido en tu imperio! ¡Mata a los demonios que cruzaron y destruye todas las puertas!"
      },
      {
        "id": "1037",
        "name": "POPUP_MISION_DEMONPORTAL_TITULO_END",
        "text": "¡PORTALES DESTRUIDOS!"
      },
      {
        "id": "1038",
        "name": "POPUP_MISION_DEMONPORTAL_FOOTER_END",
        "text": "¡EXCELENTE! ¡Derrotaste a todos los demonios y destruiste los portales! ¡Tu imperio ahora está a salvo!"
      },
