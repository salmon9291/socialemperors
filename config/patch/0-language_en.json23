        "id": "992",
        "name": "POPUP_MISION_AZTECALTAR_TITULO_END",
        "text": "¡Los dioses aztecas escucharon tus deseos!"
      },
      {
        "id": "993",
        "name": "POPUP_MISION_AZTECALTAR_FOOTER_END",
        "text": "¡Los dioses aztecas llevarán la lluvia a tus campos para acabar con el hambre!"
