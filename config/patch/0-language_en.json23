      },
      {
        "id": "1940",
        "name": "POPUP_RECRUIT_DESC_1",
        "text": "Strike your foes with the God of Thunder! \nGET THOR AS YOUR ALLY!"
      },
      {
        "id": "1941",
        "name": "POPUP_RECRUIT_DESC_2",
        "text": "Stomp and daze your enemies with 7 tons of power! \nGET 1 ELEPHANT RIDER!"
      },
      {
        "id": "1942",
        "name": "POPUP_RECRUIT_DESC_3",
        "text": "A wheeled tower! Fight wherever you want! \nGET 1 MOBILE TOWER!"
      },
      {
        "id": "1943",
        "name": "POPUP_RECRUIT_DESC_4",
        "text": "Convert enemies into allies with the power of faith! \nRECRUIT THE MONK!"
      },
      {
        "id": "1944",
        "name": "POPUP_RECRUIT_DESC_5",
        "text": "Smash your enemies and reduce them to dust! \nSUMMON THE STONE GOLEM!"
      },
      {
        "id": "1945",
        "name": "POPUP_RECRUIT_DESC_6",
        "text": "The most feared creatures... after his master, the Death Dragon! \nGET 2 DEATH DRAGGIES!"
      },
      {
        "id": "1946",
        "name": "POPUP_RECRUIT_DESC_7",
        "text": "Infiltrate, massacre and steal all resources without being seen! \nGET THE INVISIBLE KILLER!"
      },
      {
        "id": "1947",
        "name": "POPUP_RECRUIT_DESC_8",
        "text": "The power of love will guide your troops! \nPARTNER MEGA HEALING ANGEL!"
      },
      {
        "id": "1948",
        "name": "POPUP_RECRUIT_DESC_9",
        "text": "Septum piercings make them more extreme more enraged! \nGET 2 EXTREME BULL DRAGGIES!"
      },
      {
        "id": "1949",
        "name": "POPUP_RECRUIT_DESC_10",
        "text": "As shiny as deadly, all princesses want a piece of him! \nGET THE RUBIES DRAGON!"
      },
      {
        "id": "1950",
        "name": "POPUP_RECRUIT_DESC_11",
        "text": "The power of jade: the secret of a millenary empire! \nINVOKE THE DYNASTY DRAGON!"
      },
      {
        "id": "1951",
        "name": "POPUP_RECRUIT_DESC_12",
        "text": "It's electrifying! Last recruitable unit by now: more coming soon! \nGET 1 ELECTRIC EXTREME DRAGON!"
      },
      {
        "id": "1952",
        "name": "POPUP_RECRUIT_NO_PRICES",
        "text": "Recruit has no prizes!"
      },
      {
        "id": "1953",
        "name": "HELP_TEXT_RECRUIT",
        "text": "THE NEW RECRUITMENT PRIZES ARE HERE! \n 1. CHOOSE your favorite unit. \n2. INVITE as many friends as needed. \n3. GET the unit after the selected friends have accepted the RECRUITMENT. \n\n -TIPS- \n Recruitment requests are accepted in the message center. \n Your friends need to reach level 5 in order to access the message center. \n Advanced units are locked by level, but you can unlock them getting all previous ones!"
      },
      {
        "id": "1954",
        "name": "ALERT_TAVERN_NEEDED",
        "text": "Build the Recruitment Prizes building before getting awesome rewards!"
      },
      {
        "id": "1955",
        "name": "POPUP_IVORY_TITLE",
        "text": "The Ivory Challenge!"
      },
      {
        "id": "1956",
        "name": "POPUP_IVORY_INFO",
        "text": "Unlock the door to release the Ivory Dynasty Dragon\nGet the Dynasty Keys inviting new friends!"
      },
      {
        "id": "1957",
        "name": "POPUP_IVORY_REWARD",
        "text": "Congratulations!\nYou won the Dragon!\nSearch it in your storage"
      },
