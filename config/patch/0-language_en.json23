      },
      {
        "id": "154",
        "name": "AVISO_POCO_NIVEL_PARA_CONQUISTAR",
        "text": "Tu imperio es demasiado pequeño para conquistar el mundo. Alcanza el nivel #0# para desbloquear el explorador mundial."
      },
      {
        "id": "155",
        "name": "AVISO_COLECCION_FACCION",
        "text": "No puedes acceder a las colecciones de esta facción."
      },
      {
        "id": "156",
        "name": "AVISO_GRIMORIO_TITULO",
        "text": "¡Libro de hechizos disponible!"
      },
      {
        "id": "157",
        "name": "AVISO_GRIMORIO_DESCRIPCION",
        "text": "¡Has desbloqueado el libro de hechizos!\n¡Ahora puedes aprender y lanzar poderosos hechizos!\nEncontrarás el libro en la parte inferior izquierda de la pantalla."
      },
      {
        "id": "158",
        "name": "AVISO_TOPE_UNIDADES",
        "text": "No se pueden tener más unidades de este tipo."
      },
      {
        "id": "159",
        "name": "AVISO_TOPE_POBLACION",
        "text": "Has alcanzado la población máxima."
      },
      {
        "id": "160",
        "name": "AVISO_TOPE_ALOJAMIENTO",
        "text": "No puedes acomodar más\npoblación. construir más casas,\nmejora tu Ayuntamiento o construye\nmaravillas de la población"
      },
      {
        "id": "161",
        "name": "AVISO_NIVEL_MEJORAR",
        "text": "Debes estar en el nivel #0# para mejorar este edificio."
      },
      {
        "id": "162",
        "name": "AVISO_SIN_MADERA_GRANJA",
        "text": "¡Oh, no! ¡No tienes suficiente madera para reconstruir la granja!"
      },
      {
        "id": "163",
        "name": "AVISO_MUELLE_TITULO",
        "text": "¡Operativo del muelle!"
      },
      {
        "id": "164",
        "name": "AVISO_MUELLE_DESCRIPCION",
        "text": "¡Haz clic en el Puerto para navegar por el Gran Mar!"
      },
      {
        "id": "165",
        "name": "AVISO_ZEPPELIN_TITULO",
        "text": "¡Operativo Zepelín!"
      },
      {
        "id": "166",
        "name": "AVISO_ZEPPELIN_DESCRIPCION",
        "text": "¡Haz clic en la Torre Zeppelin para volar a través del Mar Antiguo!"
      },
      {
        "id": "167",
        "name": "AVISO_SIN_AYUDAS",
        "text": "¡No más asistencias disponibles! \n ¡Vuelve mañana!"
      },
      {
        "id": "168",
        "name": "AVISO_TOPE_TORRES",
        "text": "Solo puedes tener #0# torres en tu imperio por cada expansión que poseas."
      },
      {
        "id": "169",
        "name": "AVISO_BOCADILLOS",
        "text": "¡Bocadillos habilitados!\n\n¡Disfruta del monstruo!"
      },
      {
        "id": "170",
        "name": "AVISO_SANGRE",
        "text": "¡Modo sangre habilitado!\n\nLo estabas pidiendo... ¡monstruo!"
      },
      {
        "id": "171",
        "name": "AVISO_PACK_COMPRADO",
        "text": "¡Felicidades!\n¡Adquiriste el paquete!\n\nRevisa tu tienda"
      },
      {
        "id": "172",
        "name": "AVISO_PACK_FALTA_DINERO",
        "text": "No tienes suficiente dinero en efectivo para conseguir el paquete. ¿Quieres conseguir algo de efectivo?"
      },
      {
        "id": "173",
        "name": "AVISO_UNIDAD_UNICA",
        "text": "No puedes tener dos de esta unidad al mismo tiempo."
      },
      {
        "id": "174",
        "name": "AVISO_SUFICIENTE_ORO",
        "text": "¡Oh, no! ¡No tienes suficiente oro! ¿Quieres conseguir más?"
      },
      {
        "id": "175",
        "name": "AVISO_SUFICIENTE_CASH",
        "text": "¡Oh, no! ¡No tienes suficiente efectivo! ¿Quieres conseguir más?"
      },
      {
        "id": "176",
        "name": "AVISO_SUFICIENTE_COMIDA",
        "text": "¡No tienes suficiente comida!\nObtenga alimentos de granjas, molinos y ranchos."
      },
      {
        "id": "177",
        "name": "AVISO_SUFICIENTE_MADERA",
        "text": "¡No tienes suficiente madera!\nCosecha más árboles."
      },
      {
        "id": "178",
        "name": "AVISO_SUFICIENTE_PIEDRA",
        "text": "¡No tienes suficiente piedra!\nCoseche más vetas de piedra."
      },
      {
        "id": "179",
