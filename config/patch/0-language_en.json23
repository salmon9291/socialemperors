[
  {
    "op": "replace",
    "path": "/localization_strings",
    "value": [
      {
        "id": "1",
        "name": "TUTORIAL_INTRO_TITULO",
        "text": "¡Bienvenido a tu Imperio!"
      },
      {
        "id": "2",
        "name": "TUTORIAL_INTRO_LECCION",
        "text": "Hola, soy #0#! Estoy aquí para mostrarte cómo administrar tu Imperio.\n\n¡Empecemos!"
      },
      {
        "id": "3",
        "name": "TUTORIAL_AYTO_TITULO",
        "text": "Seleccionar ayuntamiento"
      },
      {
        "id": "4",
        "name": "TUTORIAL_AYTO_LECCION",
        "text": "Este es tu Ayuntamiento. Te permitirá entrenar a los aldeanos.\n\nPara seleccionar el Ayuntamiento, haga clic en él."
      },
      {
        "id": "5",
        "name": "TUTORIAL_ALDEANO_TITULO",
        "text": "Entrenar a un aldeano"
      },
      {
        "id": "6",
        "name": "TUTORIAL_ALDEANO_LECCION",
        "text": "El panel inferior mostrará las acciones disponibles.\n\nHaga clic en el botón del aldeano para comenzar a entrenar a un aldeano."
      },
      {
        "id": "7",
        "name": "TUTORIAL_SELECCIONAR_ALDEANO_TITULO",
        "text": "Selecciona el aldeano"
      },
      {
        "id": "8",
        "name": "TUTORIAL_SELECCIONAR_ALDEANO_LECCION",
        "text": "¡Bien hecho! Has entrenado a un aldeano.\n\n¡Seleccionalo usando el mouse!"
      },
      {
        "id": "9",
        "name": "TUTORIAL_MOVER_ALDEANO_TITULO",
        "text": "Mueve al aldeano"
      },
      {
        "id": "10",
        "name": "TUTORIAL_MOVER_ALDEANO_LECCION",
        "text": "Cuando seleccionas una unidad, puedes moverla haciendo clic en el lugar deseado del mapa.\n\n¡Pruébalo, haz clic en el área seleccionada!"
      },
      {
        "id": "11",
        "name": "TUTORIAL_ARBOL_TITULO",
        "text": "Recoge un árbol"
      },
      {
        "id": "12",
        "name": "TUTORIAL_ARBOL_LECCION",
        "text": "¡Los aldeanos realizan tareas de recolección!\n\n¡Haz clic en un árbol para cortarlo!"
      },
      {
        "id": "13",
        "name": "TUTORIAL_ESPERA_TITULO",
        "text": "Esperar"
      },
      {
        "id": "14",
        "name": "TUTORIAL_ESPERA_LECCION",
        "text": "Sólo te llevará unos segundos... :)"
      },
      {
        "id": "15",
        "name": "TUTORIAL_RECOLECCION_TITULO",
        "text": "Recoge la madera"
      },
      {
        "id": "16",
        "name": "TUTORIAL_RECOLECCION_LECCION",
        "text": "Cuando haya terminado el corte, haga clic en el recurso para recoger la madera."
      },
      {
        "id": "17",
        "name": "TUTORIAL_CONSTRUIR_TITULO",
        "text": "Edificio"
      },
      {
        "id": "18",
        "name": "TUTORIAL_CONSTRUIR_LECCION",
        "text": "¡Bien hecho! Ahora te mostraré cómo crear edificios. Primero, haga clic en el botón CONSTRUIR."
      },
      {
        "id": "19",
        "name": "TUTORIAL_CASA_TITULO",
        "text": "Seleccionar casa"
      },
      {
        "id": "20",
        "name": "TUTORIAL_CASA_LECCION",
        "text": "El siguiente paso es seleccionar el edificio deseado. Elija la Casa I."
      },
      {
        "id": "21",
        "name": "TUTORIAL_COLOCAR_TITULO",
        "text": "Coloca la casa"
      },
      {
        "id": "22",
        "name": "TUTORIAL_COLOCAR_LECCION",
        "text": "Ahora haz clic en el terreno para elegir la ubicación de la casa. ¡La construcción comenzará!"
      },
      {
        "id": "23",
        "name": "TUTORIAL_CABALLERO_TITULO",
        "text": "Selecciona el caballero"
      },
      {
        "id": "24",
        "name": "TUTORIAL_CABALLERO_LECCION",
        "text": "¡Bien hecho! Estás listo para tu primera batalla.\n\n¡Haz clic en este caballero para seleccionarlo!"
      },
      {
        "id": "25",
        "name": "TUTORIAL_ATACAR_TITULO",
        "text": "Atacar al trol"
      },
      {
        "id": "26",
        "name": "TUTORIAL_ATACAR_LECCION",
        "text": "¡Los trolls son tus enemigos! ¡Derrótalos o te eliminarán!\n\n¡Haz clic en el troll para atacarlo!"
      },
      {
        "id": "27",
        "name": "TUTORIAL_BATALLA_TITULO",
        "text": "Espera la batalla"
      },
      {
        "id": "28",
        "name": "TUTORIAL_BATALLA_LECCION",
        "text": "Las unidades se están atacando entre sí ahora mismo. Las barras sobre ellos muestran su vida. ¡No te preocupes, son sólo trolls débiles!"
      },
      {
        "id": "29",
        "name": "TUTORIAL_ENHORABUENA_TITULO",
        "text": "¡Felicidades!"
      },
      {
        "id": "30",
        "name": "TUTORIAL_ENHORABUENA_LECCION",
        "text": "¡Muy bien! ¡Ahora estás listo para construir el mayor imperio social en Facebook! ¡¡Buena suerte!!"
      },
      {
