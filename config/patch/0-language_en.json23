      },
      {
        "id": "989",
        "name": "POPUP_MISION_THEMUMMY_FOOTER_END",
        "text": "¡SÍ! ¡Mataste a la momia! ¡Un egipcio se une a tus filas para agradecerte por ayudar a su pueblo!"
      },
      {
        "id": "990",
        "name": "POPUP_MISION_AZTECALTAR_TITULO",
