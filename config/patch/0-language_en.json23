      {
        "id": "956",
        "name": "POPUP_MISION_FIREWORKS_FOOTER_END",
        "text": "¡Los guerreros chinos vuelven a estar felices y te regalan una estatua de dragón como agradecimiento por tu ayuda!"
      },
      {
        "id": "957",
        "name": "POPUP_MISION_VIKBEER_FOOTER_END",
